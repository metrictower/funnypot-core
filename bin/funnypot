#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * funnypot CLI.
 *
 *   funnypot compile <templates-dir> [--out=PATH]
 *
 * Compiles the nuclei http template corpus into the schema-1 routing index plus
 * manifest.json / skipped.json sidecars. symfony/yaml (a compile-time-only dependency)
 * must be installed in the package vendor/.
 */

use Funnypot\Core\Compiler\ArtifactWriter;
use Funnypot\Core\Compiler\Compiler;
use Funnypot\Core\Compiler\Crs\CrsCompiler;
use Funnypot\Core\Manifest\ManifestBuilder;
use Funnypot\Core\Manifest\RouteIntegrity;
use Symfony\Component\Yaml\Yaml;

$root = dirname(__DIR__);

$autoload = $root . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Missing vendor/autoload.php — run `composer install` in the package.\n");
    exit(2);
}
require $autoload;

$argvv = $argv;
array_shift($argvv);
$command = array_shift($argvv) ?? '';

if (strncmp($command, 'rules:', 6) === 0) {
    exit(handleRulesCommand($command, $argvv));
}

if ($command === 'compile-emulators') {
    $dir = $root . '/templates/attack';
    $out = $root . '/resources/compiled/funnypot-attack.php';
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--out=', 6) === 0) {
            $out = substr($arg, 6);
        } elseif (strncmp($arg, '--', 2) !== 0) {
            $dir = $arg;
        }
    }
    if (!is_dir($dir)) {
        fwrite(STDERR, "error: attack-template dir not found: {$dir}\n");
        exit(2);
    }
    // CRS-derived templates live alongside the hand-authored ones and merge into the same
    // first-match-wins set (they carry a high `priority`, so the specific hand rules stay
    // ahead of the broad CRS alternation). Absent when compile-crs hasn't been run.
    $dirs = [$dir];
    $crsDir = dirname($dir) . '/attack-crs';
    if ($dir === $root . '/templates/attack' && is_dir($crsDir)) {
        $dirs[] = $crsDir;
    }
    // Catalog-derived AI attack templates written by `compile-ai` merge in the same way —
    // `priority` (then `id`) is the real key. Absent when compile-ai hasn't been run.
    $aiDir = dirname($dir) . '/attack-ai';
    if ($dir === $root . '/templates/attack' && is_dir($aiDir)) {
        $dirs[] = $aiDir;
    }
    $rules = (new Funnypot\Core\Compiler\EmulatorCompiler())->compileDirs($dirs);
    $php = "<?php\n\ndeclare(strict_types=1);\n\n// GENERATED by `funnypot compile-emulators` — DO NOT EDIT.\n\nreturn "
        . var_export($rules, true) . ";\n";
    if (!is_dir(dirname($out))) {
        mkdir(dirname($out), 0777, true);
    }
    file_put_contents($out, $php);
    fwrite(STDOUT, count($rules) . " attack rules compiled -> {$out}\n");
    exit(0);
}

if ($command === 'compile-routes') {
    $dir = $root . '/templates/route';
    $out = $root . '/resources/compiled/funnypot-routes.php';
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--out=', 6) === 0) {
            $out = substr($arg, 6);
        } elseif (strncmp($arg, '--', 2) !== 0) {
            $dir = $arg;
        }
    }
    if (!is_dir($dir)) {
        fwrite(STDERR, "error: route-template dir not found: {$dir}\n");
        exit(2);
    }
    // Catalog-derived AI route templates written by `compile-ai` live in a sibling generated dir
    // and merge into the same first-match-wins set (priority is the real key). Same pattern as
    // compile-emulators folding templates/attack-crs. Absent when compile-ai hasn't been run.
    // realpath() (not a raw string compare) so a relative or trailing-slash invocation of the
    // canonical route dir still resolves to the same path and folds the generated dir.
    $dirs = [$dir];
    $genDir = dirname($dir) . '/generated';
    if (realpath($dir) === realpath($root . '/templates/route') && is_dir($genDir)) {
        $dirs[] = $genDir;
    }
    $rules = (new Funnypot\Core\Compiler\RouteEmulatorCompiler())->compileDirs($dirs);
    $php = "<?php\n\ndeclare(strict_types=1);\n\n// GENERATED by `funnypot compile-routes` — DO NOT EDIT.\n\nreturn "
        . var_export($rules, true) . ";\n";
    if (!is_dir(dirname($out))) {
        mkdir(dirname($out), 0777, true);
    }
    file_put_contents($out, $php);
    fwrite(STDOUT, count($rules) . " route rules compiled -> {$out}\n");

    // Brand-new pages (new_page blocks) also emit an index fragment for the fold step.
    $fragment = (new Funnypot\Core\Compiler\RouteBundleSynth())->fragmentDirs($dirs);
    if ($fragment['routes'] !== []) {
        $fragOut = dirname($out) . '/funnypot-routes-index.php';
        file_put_contents(
            $fragOut,
            "<?php\n\ndeclare(strict_types=1);\n\n// GENERATED by `funnypot compile-routes` — DO NOT EDIT.\n\nreturn "
            . var_export($fragment, true) . ";\n"
        );
        fwrite(STDOUT, count($fragment['routes']) . " new-page route keys -> {$fragOut} (fold with merge-routes)\n");
    }
    exit(0);
}

if ($command === 'compile-ai') {
    // Emit the catalog-driven Ollama GET recon pages (/api/tags, /api/ps) as route templates in
    // templates/generated/, so the served bodies have ONE source of truth: Funnypot\Core\Ai\ModelCatalog.
    // This only writes YAML — run `compile-routes` (picks up templates/generated automatically) then
    // `merge-routes` to land the pages in the compiled index. Same generate-then-compile split as
    // compile-crs -> compile-emulators.
    $genDir = $root . '/templates/generated';
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--out=', 6) === 0) {
            $genDir = substr($arg, 6);
        }
    }
    $catalog = Funnypot\Core\Ai\ModelCatalog::fromPackage();
    $firstModel = (string) ($catalog->all()[0]['name'] ?? '');

    // Each spec becomes one new_page route whose body is json_encode() of a catalog projection. The
    // heavy `weight` makes the AI persona the served bundle wherever a niche corpus template probes
    // the same path (e.g. the Ollama-unauth detection already on /api/tags); detection is unaffected.
    $specs = [
        'ai-ollama-tags' => [
            'id' => 'route-ai-ollama-tags',
            'priority' => 271,
            'name' => 'Exposed Ollama model list',
            'paths' => ['/api/tags'],
            'body_words' => ['"models"'],
            'expect' => ['"models"', $firstModel],
            'payload' => $catalog->ollamaTags(),
        ],
        'ai-ollama-ps' => [
            'id' => 'route-ai-ollama-ps',
            'priority' => 272,
            'name' => 'Exposed Ollama running models',
            'paths' => ['/api/ps'],
            'body_words' => ['"models"'],
            'expect' => ['"size_vram"', '"expires_at"'],
            'payload' => $catalog->ollamaPs(),
        ],
    ];

    if (!is_dir($genDir)) {
        mkdir($genDir, 0777, true);
    }
    // The dir holds ONLY generated templates — clear stale ones so a dropped spec never lingers.
    foreach (glob(rtrim($genDir, '/') . '/*.yaml') ?: [] as $stale) {
        unlink($stale);
    }

    $header = "# GENERATED by `funnypot compile-ai` from resources/ai/model-catalog.php — DO NOT EDIT.\n"
        . "# One source of truth: bodies are json_encode(ModelCatalog projections). Re-run after a\n"
        . "# catalog change, then `funnypot compile-routes` + `funnypot merge-routes` to recompile.\n";
    foreach ($specs as $name => $spec) {
        $doc = [
            'id' => $spec['id'],
            'priority' => $spec['priority'],
            'new_page' => [
                'method' => 'GET',
                'paths' => $spec['paths'],
                'sig' => 0,
                'status' => 200,
                'severity' => 'medium',
                'tags' => ['ai-recon', 'exposure', 'appliance'],
                'name' => $spec['name'],
                'body_words' => $spec['body_words'],
                'weight' => 1000,
            ],
            'response' => [
                'headers' => ['Content-Type' => 'application/json; charset=utf-8'],
                'body' => (string) json_encode($spec['payload'], JSON_UNESCAPED_SLASHES),
            ],
            'expect' => $spec['expect'],
        ];
        file_put_contents($genDir . '/' . $name . '.yaml', $header . Yaml::dump($doc, 6, 2));
    }

    fwrite(STDOUT, count($specs) . " AI route template(s) -> {$genDir}\n");
    fwrite(STDOUT, "  run `funnypot compile-routes` then `funnypot merge-routes` to land them in the index.\n");

    // --- owns_path ATTACK tier ----------------------------------------------------------------
    // The AI attack surface, emitted as attack templates into templates/attack-ai/;
    // `compile-emulators` globs that dir alongside templates/attack. Each rule claims its path via
    // owns_path, so the AI fake wins deterministically over the persona-weight route lottery.
    $attackDir = $root . '/templates/attack-ai';
    if (!is_dir($attackDir)) {
        mkdir($attackDir, 0777, true);
    }
    // The dir holds ONLY generated attack templates — clear stale ones so a dropped rule never lingers.
    foreach (glob(rtrim($attackDir, '/') . '/*.yaml') ?: [] as $stale) {
        unlink($stale);
    }

    $ct = 'application/json; charset=utf-8';
    // Bounded model capture: [^"] already excludes the quote, so a reflected model can't break the
    // JSON string it is echoed into. Shared by /api/show and every chat-floor dialect.
    $modelCapture = ['in' => 'body', 'regex' => '"model"\s*:\s*"([^"]{0,128})"', 'capture' => true, 'ci' => false];
    $attackDocs = [];

    // A4b — claim the three GET recon pages. The served body is the SAME bytes the route serves, so
    // ModelCatalog stays the single source of truth; owns_path is what makes the AI fake win 100%.
    $getClaims = [
        ['id' => 'attack-ai-ollama-version', 'priority' => 32, 'path' => '/api/version',
            'body' => '{"version":"0.11.4"}', 'expect' => ['"version"']],
        ['id' => 'attack-ai-ollama-tags', 'priority' => 33, 'path' => '/api/tags',
            'body' => (string) json_encode($catalog->ollamaTags(), JSON_UNESCAPED_SLASHES), 'expect' => ['"models"']],
        ['id' => 'attack-ai-ollama-ps', 'priority' => 34, 'path' => '/api/ps',
            'body' => (string) json_encode($catalog->ollamaPs(), JSON_UNESCAPED_SLASHES), 'expect' => ['"models"']],
    ];
    foreach ($getClaims as $c) {
        $attackDocs[$c['id']] = [
            'id' => $c['id'],
            'severity' => 'medium',
            'priority' => $c['priority'],
            'tags' => ['ai-recon', 'exposure', 'appliance'],
            'owns_path' => [$c['path']],
            'status' => 200,
            'match' => [
                ['in' => 'path', 'regex' => '^' . preg_quote($c['path'], '~') . '/?$', 'ci' => false],
                ['in' => 'method', 'regex' => '^GET$', 'ci' => false],
            ],
            'response' => ['headers' => ['Content-Type' => $ct], 'body' => $c['body']],
            'expect' => $c['expect'],
        ];
    }

    // A6 — /api/show: a known model returns its full show payload; an unknown one is a 404 that
    // reflects the captured name (quote-safe via the [^"] capture). One branch case per catalog model.
    $showCases = [];
    foreach ($catalog->all() as $entry) {
        $name = (string) $entry['name'];
        $show = (string) json_encode($catalog->ollamaShow($name), JSON_UNESCAPED_SLASHES);
        // ollamaShow embeds the Ollama Modelfile template literal `{{ .Prompt }}`. Escape it so the
        // bounded directive renderer emits it verbatim instead of resolving an unknown directive.
        $show = str_replace('{{ .Prompt }}', '{{{{ .Prompt }}}}', $show);
        $showCases[] = [
            'when' => ['in' => 'match.1', 'regex' => '^' . preg_quote($name, '~') . '$', 'ci' => false],
            'response' => ['status' => 200, 'headers' => ['Content-Type' => $ct], 'body' => $show],
        ];
    }
    $attackDocs['attack-ai-ollama-show'] = [
        'id' => 'attack-ai-ollama-show',
        'severity' => 'medium',
        'priority' => 35,
        'tags' => ['ai-recon', 'exposure', 'appliance'],
        'owns_path' => ['/api/show'],
        'status' => 404,
        'match' => [
            ['in' => 'path', 'regex' => '^/api/show/?$', 'ci' => false],
            ['in' => 'method', 'regex' => '^POST$', 'ci' => false],
            $modelCapture,
        ],
        'behavior' => 'branch',
        'branch' => ['cases' => $showCases],
        'response' => ['headers' => ['Content-Type' => $ct], 'body' => '{"error":"model \'{{match.1}}\' not found"}'],
        'expect' => ['"error"', 'not found'],
    ];

    // A7 — chat FLOOR: buffered (stream:false) shapes with a STATIC deliberately-wrong answer, the
    // model echoed from the request. Catalog-independent, so no per-model branch. At runtime the app's
    // Tier-2 chat handler returns ahead of core, so this floor only serves when that handler is off —
    // no special ordering needed here.
    $nonsense = '{{pick:The capital of France is Berlin.,Two plus two equals five.,'
        . 'Water boils at forty degrees Celsius.,The sun orbits the Earth once per day.}}';
    $chatFloors = [
        ['id' => 'attack-ai-ollama-chat', 'priority' => 36, 'path' => '/api/chat', 'ct' => $ct, 'expect' => ['"done":true'],
            'body' => '{"model":"{{match.1}}","created_at":"2026-08-01T00:00:00Z","message":{"role":"assistant","content":"' . $nonsense . '"},"done":true,"done_reason":"stop","total_duration":4883583458,"load_duration":1334875,"prompt_eval_count":26,"prompt_eval_duration":342546000,"eval_count":32,"eval_duration":1200000000}'],
        ['id' => 'attack-ai-ollama-generate', 'priority' => 37, 'path' => '/api/generate', 'ct' => $ct, 'expect' => ['"done":true'],
            'body' => '{"model":"{{match.1}}","created_at":"2026-08-01T00:00:00Z","response":"' . $nonsense . '","done":true,"done_reason":"stop","context":[1,2,3],"total_duration":4883583458,"load_duration":1334875,"prompt_eval_count":26,"prompt_eval_duration":342546000,"eval_count":32,"eval_duration":1200000000}'],
        ['id' => 'attack-ai-openai-chat', 'priority' => 38, 'path' => '/v1/chat/completions', 'ct' => 'application/json', 'expect' => ['"chat.completion"'],
            'body' => '{"id":"chatcmpl-B7kQw2ZfR3nT8xLmPa4Vd","object":"chat.completion","created":1769904000,"model":"{{match.1}}","choices":[{"index":0,"message":{"role":"assistant","content":"' . $nonsense . '","refusal":null},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":19,"completion_tokens":10,"total_tokens":29}}'],
        ['id' => 'attack-ai-anthropic-messages', 'priority' => 42, 'path' => '/v1/messages', 'ct' => 'application/json', 'expect' => ['"stop_reason"'],
            'body' => '{"id":"msg_014kQw2ZfR3nT8xLmPa4VdRs","type":"message","role":"assistant","model":"{{match.1}}","content":[{"type":"text","text":"' . $nonsense . '"}],"stop_reason":"end_turn","stop_sequence":null,"usage":{"input_tokens":21,"output_tokens":10}}'],
    ];
    foreach ($chatFloors as $c) {
        $attackDocs[$c['id']] = [
            'id' => $c['id'],
            'severity' => 'medium',
            'priority' => $c['priority'],
            'tags' => ['ai-recon', 'exposure', 'appliance'],
            'owns_path' => [$c['path']],
            'status' => 200,
            'match' => [
                ['in' => 'path', 'regex' => '^' . preg_quote($c['path'], '~') . '/?$', 'ci' => false],
                ['in' => 'method', 'regex' => '^POST$', 'ci' => false],
                $modelCapture,
            ],
            'response' => ['headers' => ['Content-Type' => $c['ct']], 'body' => $c['body']],
            'expect' => $c['expect'],
        ];
    }

    // A5 — /v1/models: the advertised model list, header-branched by client shape. Default is the
    // OpenAI list envelope; a request carrying an `anthropic-version` header gets the Anthropic
    // shape instead. Both bodies are json_encode() of a ModelCatalog projection, so the catalog is
    // the single source of truth — this OVERRIDES the generic gpt-4o /v1/models stub via owns_path.
    // GET-only, and the path match keeps the rule from claiming any other GET in the linear scan
    // (owns_path only settles precedence over the static stub; it does NOT gate the match).
    $openAiModels = (string) json_encode($catalog->openAiModels(), JSON_UNESCAPED_SLASHES);
    $anthropicModels = (string) json_encode($catalog->anthropicModels(), JSON_UNESCAPED_SLASHES);
    $attackDocs['attack-ai-v1-models'] = [
        'id' => 'attack-ai-v1-models',
        'severity' => 'medium',
        'priority' => 43,
        'tags' => ['ai-recon', 'exposure', 'appliance'],
        'owns_path' => ['/v1/models'],
        'status' => 200,
        'match' => [
            ['in' => 'path', 'regex' => '^/v1/models/?$', 'ci' => false],
            ['in' => 'method', 'regex' => '^GET$', 'ci' => false],
        ],
        'behavior' => 'branch',
        'branch' => ['cases' => [
            [
                'when' => ['in' => 'header:anthropic-version', 'regex' => '.+', 'ci' => false],
                'response' => [
                    'status' => 200,
                    'headers' => ['Content-Type' => 'application/json'],
                    'body' => $anthropicModels,
                ],
                'expect' => ['"type":"model"', '"has_more"'],
            ],
        ]],
        'response' => ['headers' => ['Content-Type' => 'application/json'], 'body' => $openAiModels],
        'expect' => ['"object":"list"'],
    ];

    $attackHeader = "# GENERATED by `funnypot compile-ai` from resources/ai/model-catalog.php — DO NOT EDIT.\n"
        . "# owns_path AI attack tier. Re-run after a catalog change, then `funnypot compile-emulators`.\n";
    foreach ($attackDocs as $id => $doc) {
        $file = $attackDir . '/' . $doc['priority'] . '-' . substr($id, strlen('attack-')) . '.yaml';
        file_put_contents($file, $attackHeader . Yaml::dump($doc, 8, 2));
    }

    fwrite(STDOUT, count($attackDocs) . " AI attack template(s) -> {$attackDir}\n");
    fwrite(STDOUT, "  run `funnypot compile-emulators` to land them in the attack index.\n");
    exit(0);
}

if ($command === 'merge-routes') {
    // Fold new-page bundles into a compiled index. Additive: a new route key is inserted;
    // an existing key gets the bundle appended (and, if capped, its id added to 'd' + a
    // mid weight tier stamped). Schema stays 1.
    $indexPath = $root . '/resources/compiled/nuclei-index.full.php';
    $fragPath = $root . '/resources/compiled/funnypot-routes-index.php';
    $out = null;
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--fragment=', 11) === 0) {
            $fragPath = substr($arg, 11);
        } elseif (strncmp($arg, '--out=', 6) === 0) {
            $out = substr($arg, 6);
        } elseif (strncmp($arg, '--', 2) !== 0) {
            $indexPath = $arg;
        }
    }
    $out = $out ?? $indexPath;
    if (!is_file($indexPath)) {
        fwrite(STDERR, "error: index not found: {$indexPath}\n");
        exit(2);
    }
    if (!is_file($fragPath)) {
        fwrite(STDERR, "error: fragment not found: {$fragPath} (run compile-routes first)\n");
        exit(2);
    }
    $index = require $indexPath;
    $fragment = require $fragPath;
    if (!is_array($index) || (int) ($index['schema'] ?? 0) !== 1) {
        fwrite(STDERR, "error: index is not a schema-1 array\n");
        exit(2);
    }

    foreach ((array) ($fragment['templates'] ?? []) as $id => $entry) {
        $index['templates'][$id] = $entry;
    }
    $folded = 0;
    foreach ((array) ($fragment['routes'] ?? []) as $key => $bundles) {
        foreach ((array) $bundles as $bundle) {
            if (!isset($index['routes'][$key])) {
                $index['routes'][$key] = ['b' => [$bundle]];
            } else {
                // Idempotent: a re-fold must not duplicate a new-page bundle. Its pid is
                // unique (route-*), so skip if one with this pid is already present here.
                foreach ((array) $index['routes'][$key]['b'] as $existing) {
                    if (($existing['pid'] ?? null) === ($bundle['pid'] ?? '~')) {
                        continue 2;
                    }
                }
                if (isset($index['routes'][$key]['d'])) {
                    // Capped key: keep detect coverage in 'd', give the injected bundle a
                    // mid persona-weight tier so it neither dominates nor vanishes.
                    $bundle['w'] = 8;
                    $index['routes'][$key]['d'] = array_values(array_unique(
                        array_merge((array) $index['routes'][$key]['d'], (array) $bundle['t'])
                    ));
                }
                $index['routes'][$key]['b'][] = $bundle;
            }
            $folded++;
        }
    }

    $php = "<?php\n\ndeclare(strict_types=1);\n\n// GENERATED index (nuclei corpus + folded funnypot new-page routes).\n\nreturn "
        . var_export($index, true) . ";\n";
    file_put_contents($out, $php);
    fwrite(STDOUT, "{$folded} new-page bundle(s) folded -> {$out}\n");
    exit(0);
}

if ($command === 'compile-params') {
    $dir = $root . '/templates/param';
    $out = $root . '/resources/compiled/funnypot-param.php';
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--out=', 6) === 0) {
            $out = substr($arg, 6);
        } elseif (strncmp($arg, '--', 2) !== 0) {
            $dir = $arg;
        }
    }
    if (!is_dir($dir)) {
        fwrite(STDERR, "error: param-template dir not found: {$dir}\n");
        exit(2);
    }
    // Param ids share the runtime ruleById id-space with the attack set, so a collision would
    // resolve the wrong rule. Feed the compiled attack ids in so the compiler rejects one.
    $reservedIds = [];
    $attackPath = $root . '/resources/compiled/funnypot-attack.php';
    if (is_file($attackPath)) {
        foreach ((array) require $attackPath as $rule) {
            if (is_array($rule) && isset($rule['id'])) {
                $reservedIds[] = (string) $rule['id'];
            }
        }
    }
    $index = (new Funnypot\Core\Compiler\ParamRouteCompiler())->compile($dir, $reservedIds);
    $php = "<?php\n\ndeclare(strict_types=1);\n\n// GENERATED by `funnypot compile-params` — DO NOT EDIT.\n\nreturn "
        . var_export($index, true) . ";\n";
    if (!is_dir(dirname($out))) {
        mkdir(dirname($out), 0777, true);
    }
    file_put_contents($out, $php);
    $count = 0;
    foreach ((array) $index['buckets'] as $entries) {
        $count += count((array) $entries);
    }
    fwrite(STDOUT, $count . ' param route(s) in ' . count((array) $index['buckets']) . " bucket(s) compiled -> {$out}\n");
    exit(0);
}

if ($command === 'compile-crs') {
    // Parse an OWASP CoreRuleSet rules/ dir into funnypot attack templates: one broadened
    // template per attack class, reusing that class's existing response archetype. Feeds
    // TIER 2 (TemplateAttackEmulator) only — never the nuclei routing corpus.
    $dir = null;
    $out = $root . '/templates/attack-crs';
    $pl = 1;
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--out=', 6) === 0) {
            $out = substr($arg, 6);
        } elseif (strncmp($arg, '--pl=', 5) === 0) {
            $pl = max(1, (int) substr($arg, 5));
        } elseif ($dir === null && strncmp($arg, '--', 2) !== 0) {
            $dir = $arg;
        }
    }
    if ($dir === null || !is_dir($dir)) {
        fwrite(STDERR, "error: coreruleset rules dir not found: " . ($dir ?? '(none)') . "\n");
        exit(2);
    }

    $result = (new CrsCompiler($root))->compile($dir, $pl);

    if (!is_dir($out)) {
        mkdir($out, 0777, true);
    }
    // The out dir holds only generated CRS templates — clear stale ones so a class dropped
    // upstream doesn't linger.
    foreach (glob(rtrim($out, '/') . '/*.yaml') ?: [] as $stale) {
        unlink($stale);
    }
    $header = "# GENERATED by `funnypot compile-crs` from OWASP CoreRuleSet — DO NOT EDIT.\n"
        . "# Broadened attack-class detection behind funnypot's own response archetype.\n"
        . "# Provenance: resources/compiled/crs-manifest.json; license: resources/UPSTREAM-LICENSE-CRS.md.\n";
    foreach ($result['templates'] as $template) {
        $file = sprintf('%s/%d-crs-%s.yaml', rtrim($out, '/'), (int) $template['priority'], substr((string) $template['id'], strlen('attack-crs-')));
        file_put_contents($file, $header . Yaml::dump($template, 6, 2));
    }

    $skippedOut = $root . '/resources/skipped-crs.json';
    file_put_contents($skippedOut, json_encode($result['skipped'], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

    $meta = resolveUpstream($dir);
    $manifest = array_merge(['tag' => $meta['tag'], 'sha' => $meta['sha'], 'built_at' => $meta['built_at']], $result['manifest']);
    $manifestOut = $root . '/resources/compiled/crs-manifest.json';
    if (!is_dir(dirname($manifestOut))) {
        mkdir(dirname($manifestOut), 0777, true);
    }
    file_put_contents($manifestOut, json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

    fwrite(STDOUT, sprintf(
        "%d class template(s) written -> %s\n  kept=%d  skipped=%d  (pl<=%d)\n  skipped: %s\n  manifest: %s\n",
        count($result['templates']),
        $out,
        $result['manifest']['rules_kept'],
        $result['manifest']['rules_skipped'],
        $pl,
        $skippedOut,
        $manifestOut
    ));
    fwrite(STDOUT, "  run `funnypot compile-emulators` next to fold these into the runtime index.\n");
    exit(0);
}

if ($command === 'build-manifest') {
    // Derive the two-band decoy registry from the committed compiled artifacts and write it as a
    // pure array literal — same var_export writer + GENERATED header as every compile step. Inert
    // build/CI-time data (route keys, ids, families, link targets; never a served body).
    $out = $root . '/resources/compiled/funnypot-manifest.php';
    $paths = ManifestBuilder::defaultPaths($root);
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--out=', 6) === 0) {
            $out = substr($arg, 6);
        } elseif (strncmp($arg, '--attack=', 9) === 0) {
            $paths['attack'] = substr($arg, 9);
        } elseif (strncmp($arg, '--param=', 8) === 0) {
            $paths['param'] = substr($arg, 8);
        } elseif (strncmp($arg, '--nuclei=', 9) === 0) {
            $paths['nuclei'] = substr($arg, 9);
        } elseif (strncmp($arg, '--enrichers=', 12) === 0) {
            $paths['enrichers'] = substr($arg, 12);
        }
    }
    $manifest = (new ManifestBuilder())->build($paths);
    $php = "<?php\n\ndeclare(strict_types=1);\n\n// GENERATED by `funnypot build-manifest` — DO NOT EDIT.\n\nreturn "
        . var_export($manifest, true) . ";\n";
    if (!is_dir(dirname($out))) {
        mkdir(dirname($out), 0777, true);
    }
    file_put_contents($out, $php);
    fwrite(STDOUT, sprintf(
        "manifest: bandA=%d corpus-families=%d corpus-keys=%d enrichers=%d -> %s\n",
        $manifest['counts']['band_a'],
        $manifest['counts']['corpus_families'],
        $manifest['counts']['corpus_keys'],
        $manifest['counts']['enrichers'],
        $out
    ));
    exit(0);
}

if ($command === 'lint-routes') {
    // Route-integrity gate: build the manifest in-memory, run the collision / shadow / dangling-link
    // checks against it under resources/route-integrity.php, print the findings, and exit non-zero on
    // any FAIL so CI can block. WARN/INFO/ACCEPTED are reported but never gate. Never serves a byte —
    // build/CI-time only, beside scripts/ci/check-fingerprint-safety.php.
    $format = 'table';
    $configPath = $root . '/resources/route-integrity.php';
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--format=', 9) === 0) {
            $format = substr($arg, 9);
        } elseif (strncmp($arg, '--config=', 9) === 0) {
            $configPath = substr($arg, 9);
        }
    }

    $manifest = (new ManifestBuilder())->build(ManifestBuilder::defaultPaths($root));
    $config = is_file($configPath) ? require $configPath : array();
    if (!is_array($config)) {
        $config = array();
    }
    $result = (new RouteIntegrity())->analyze($manifest, $config);

    exit(renderLintRoutes($result, $format === 'json' ? 'json' : 'table'));
}

if ($command !== 'compile') {
    fwrite(STDERR, "usage: funnypot compile <templates-dir> [--out=PATH]\n");
    fwrite(STDERR, "       funnypot compile-emulators [<attack-template-dir>] [--out=PATH]\n");
    fwrite(STDERR, "       funnypot compile-routes [<route-template-dir>] [--out=PATH]\n");
    fwrite(STDERR, "       funnypot compile-ai [--out=<generated-dir>]  (route + owns_path attack templates)\n");
    fwrite(STDERR, "       funnypot compile-params [<param-template-dir>] [--out=PATH]\n");
    fwrite(STDERR, "       funnypot merge-routes [<index>] [--fragment=PATH] [--out=PATH]\n");
    fwrite(STDERR, "       funnypot compile-crs <coreruleset-rules-dir> [--out=PATH] [--pl=N]\n");
    fwrite(STDERR, "       funnypot build-manifest [--out=PATH]  (derive the two-band decoy registry)\n");
    fwrite(STDERR, "       funnypot lint-routes [--format=table|json] [--config=PATH]  (route-integrity gate)\n");
    fwrite(STDERR, "       funnypot rules:update [--data-dir=PATH] [--channel=stable] [--version=vX]\n");
    fwrite(STDERR, "       funnypot rules:status [--data-dir=PATH]\n");
    fwrite(STDERR, "       funnypot rules:rollback [--data-dir=PATH] [--to=vX]\n");
    exit($command === '' || $command === 'help' || $command === '--help' ? 0 : 2);
}

$dir = null;
$out = $root . '/resources/compiled/nuclei-index.full.php';
foreach ($argvv as $arg) {
    if (strncmp($arg, '--out=', 6) === 0) {
        $out = substr($arg, 6);
    } elseif ($dir === null && strncmp($arg, '--', 2) !== 0) {
        $dir = $arg;
    }
}

if ($dir === null || !is_dir($dir)) {
    fwrite(STDERR, "error: templates dir not found: " . ($dir ?? '(none)') . "\n");
    exit(2);
}

$meta = resolveUpstream($dir);

$start = microtime(true);
$compiler = new Compiler();
$result = $compiler->compile($dir, $meta);

$writer = new ArtifactWriter();
$paths = $writer->write($result, $out);

$elapsed = number_format(microtime(true) - $start, 1);
$stats = $result['stats'];

fwrite(STDOUT, "compiled in {$elapsed}s\n");
fwrite(STDOUT, sprintf(
    "  seen=%d  in=%d  route-keys=%d  multi-bundle-keys=%d  largest-bundle=%d  bundles=%d\n",
    $stats['total'],
    $stats['in'],
    $stats['route_keys'] ?? 0,
    $stats['multi_bundle_keys'] ?? 0,
    $stats['largest_bundle_count'] ?? 0,
    $stats['bundles_total'] ?? 0
));
fwrite(STDOUT, "  gateA-excluded=" . array_sum($stats['gateA']) . "  gateB-folded=" . array_sum($stats['gateB']) . "\n");
fwrite(STDOUT, "  index:    {$paths['index']}\n");
fwrite(STDOUT, "  manifest: {$paths['manifest']}\n");
fwrite(STDOUT, "  skipped:  {$paths['skipped']}\n");
fwrite(STDOUT, "  sha256:   {$paths['sha256']}\n");

exit(0);

/**
 * `funnypot rules:update|status|rollback` — the runtime rules-update surface. Fetches a
 * signed rules release and hot-swaps it into a data dir the engine prefers over its bundled
 * artifacts, with no composer update. Exit codes: 0 = rules are good (updated, already
 * current, or read); 1 = an update was attempted and failed (rules unchanged — worth an
 * alert, not a page: the honeypot is still up); 2 = usage/config error.
 *
 * @param string[] $args
 */
function handleRulesCommand(string $command, array $args): int
{
    $opts = [];
    foreach ($args as $arg) {
        if (preg_match('/^--([a-z-]+)=(.*)$/', $arg, $m) === 1) {
            $opts[$m[1]] = $m[2];
        }
    }

    $dataDir = $opts['data-dir'] ?? (getenv('FUNNYPOT_RULES_DIR') ?: '');
    if ($dataDir === '') {
        fwrite(STDERR, "error: no data dir. Pass --data-dir=PATH or set FUNNYPOT_RULES_DIR.\n");

        return 2;
    }

    $updater = new Funnypot\Core\Rules\RulesUpdater(
        $dataDir,
        $opts['channel'] ?? 'stable',
        $opts['version'] ?? null,
        $opts['repo'] ?? 'https://github.com/metrictower/funnypot-rules'
    );

    switch ($command) {
        case 'rules:update':
            $r = $updater->update();
            fwrite($r->success ? STDOUT : STDERR, $r->message . "\n");
            fwrite(STDOUT, json_encode($r->toArray(), JSON_UNESCAPED_SLASHES) . "\n");

            return $r->success ? 0 : 1;

        case 'rules:rollback':
            $r = $updater->rollback($opts['to'] ?? null);
            fwrite($r->success ? STDOUT : STDERR, $r->message . "\n");
            fwrite(STDOUT, json_encode($r->toArray(), JSON_UNESCAPED_SLASHES) . "\n");

            return $r->success ? 0 : 1;

        case 'rules:status':
            $s = $updater->status();
            fwrite(STDOUT, json_encode($s->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

            return 0;

        default:
            fwrite(STDERR, "usage: funnypot rules:update|rules:status|rules:rollback [--data-dir=PATH] [--channel=stable] [--version=vX] [--to=vX]\n");

            return 2;
    }
}

/**
 * Print the route-integrity findings and return the process exit code: non-zero when any FAIL
 * remains after the escape-hatch suppression (so CI blocks), 0 otherwise. `table` is the operator
 * view; `json` is the machine view.
 *
 * @param array<string,mixed> $result RouteIntegrity::analyze() output
 */
function renderLintRoutes(array $result, string $format): int
{
    $findings = $result['findings'];
    $order = array(RouteIntegrity::FAIL => 0, RouteIntegrity::WARN => 1, RouteIntegrity::ACCEPTED => 2, RouteIntegrity::INFO => 3);
    $counts = array(RouteIntegrity::FAIL => 0, RouteIntegrity::WARN => 0, RouteIntegrity::ACCEPTED => 0, RouteIntegrity::INFO => 0);
    foreach ($findings as $f) {
        $counts[$f['severity']] = ($counts[$f['severity']] ?? 0) + 1;
    }
    $fails = $counts[RouteIntegrity::FAIL];

    if ($format === 'json') {
        fwrite(STDOUT, json_encode(array(
            'ok' => $fails === 0,
            'counts' => $counts,
            'disabled_missing' => $result['disabled_missing'],
            'findings' => $findings,
        ), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

        return $fails === 0 ? 0 : 1;
    }

    usort($findings, static function (array $a, array $b) use ($order): int {
        $oa = $order[$a['severity']] ?? 9;
        $ob = $order[$b['severity']] ?? 9;
        if ($oa !== $ob) {
            return $oa - $ob;
        }

        return strcmp($a['check'] . $a['a'] . $a['path'], $b['check'] . $b['a'] . $b['path']);
    });

    $label = array(
        RouteIntegrity::FAIL => 'FAIL', RouteIntegrity::WARN => 'WARN',
        RouteIntegrity::ACCEPTED => 'ACPT', RouteIntegrity::INFO => 'INFO',
    );
    foreach ($findings as $f) {
        // INFO (designed overrides) is summarized in the footer, not printed line-by-line.
        if ($f['severity'] === RouteIntegrity::INFO) {
            continue;
        }
        $line = sprintf('[%s] %-9s %s', $label[$f['severity']] ?? '?', $f['check'], $f['message']);
        if ($f['severity'] === RouteIntegrity::ACCEPTED && ($f['accepted_reason'] ?? '') !== '') {
            $line .= "\n           accepted: " . $f['accepted_reason'];
        }
        fwrite(STDOUT, $line . "\n");
    }
    foreach ($result['disabled_missing'] as $id) {
        fwrite(STDOUT, sprintf("[WARN] disabled   escape-hatch id no longer exists: %s\n", $id));
    }

    fwrite(STDOUT, sprintf(
        "\nroute-integrity: %d FAIL, %d WARN, %d accepted, %d info(designed-override)\n",
        $counts[RouteIntegrity::FAIL],
        $counts[RouteIntegrity::WARN],
        $counts[RouteIntegrity::ACCEPTED],
        $counts[RouteIntegrity::INFO]
    ));
    fwrite($fails === 0 ? STDOUT : STDERR, $fails === 0 ? "OK\n" : "FAILED\n");

    return $fails === 0 ? 0 : 1;
}

/**
 * Best-effort upstream tag + sha from the templates repo (or an ancestor).
 *
 * @return array<string,string>
 */
function resolveUpstream(string $dir): array
{
    $git = static function (string $dir, string $args): string {
        $cmd = 'git -C ' . escapeshellarg($dir) . ' ' . $args . ' 2>/dev/null';
        $out = @shell_exec($cmd);

        return is_string($out) ? trim($out) : '';
    };

    $sha = $git($dir, 'rev-parse HEAD');
    $tag = $git($dir, 'describe --tags --always');

    return [
        'tag' => $tag !== '' ? $tag : 'unknown',
        'sha' => $sha !== '' ? $sha : 'unknown',
        'built_at' => gmdate('c'),
    ];
}
